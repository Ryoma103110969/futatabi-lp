---
import c from '../data/site.json';
import HeroReel from '../components/HeroReel.astro';
import ContentCarousel from '../components/ContentCarousel.astro';
import { asset, absolute } from '../lib/paths';
import '../styles/brand.css';
import '../styles/home.css';
const yen=(n:number)=>n.toLocaleString('ja-JP');
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'Organization','@id':`${c.siteUrl}/#organization`,name:c.companyName,url:c.siteUrl},
 {'@type':'WebSite',name:c.companyName,url:c.siteUrl},
 {'@type':'Service',name:c.serviceName,provider:{'@id':`${c.siteUrl}/#organization`},offers:c.plans.map(p=>({'@type':'Offer',name:p.name,price:p.price,priceCurrency:'JPY'}))},
 {'@type':'FAQPage',mainEntity:c.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
]};
const primary=c.cta.primaryUrl || '#connection-note';
const line=c.cta.secondaryUrl;
const external=(u:string)=>u.startsWith('http')?{target:'_blank',rel:'noopener'}:{};
// Optional records start empty. Add only verified, permission-cleared information.
const proof=c.proof as {label:string;value:string;note:string;sourceUrl:string}[];
const title=`${c.companyName}（ふたたび）｜${c.serviceName}`;
---
<!doctype html>
<html lang="ja">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="theme-color" content="#FBF6EE"/>
 <title>{title}</title><meta name="description" content={c.description}/>
 {c.demoMode && <meta name="robots" content="noindex, nofollow"/>}
 <link rel="canonical" href={absolute('/')}/><link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml"/>
 <meta property="og:type" content="website"/><meta property="og:locale" content="ja_JP"/>
 <meta property="og:title" content={title}/><meta property="og:description" content={c.description}/>
 <meta property="og:url" content={absolute('/')}/><meta property="og:site_name" content={c.companyName}/>
 <meta property="og:image" content={absolute('/og-image.png')}/><meta name="twitter:card" content="summary_large_image"/>
 <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600&family=Shippori+Mincho+B1:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet"/>
 <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/>
</head>
<body>
 <a href="#main" class="skip-link">本文へスキップ</a>
 {c.demoMode && <aside class="preview-notice">公開前プレビュー · 検索エンジンには表示されません。</aside>}
 <header class="site-header">
  <div class="w nav-row">
   <a href="#main" class="brand" aria-label={`${c.companyName} トップへ`}><span class="brand-mark" aria-hidden="true"></span><span class="brand-word">{c.companyName}<small>{c.serviceName}</small></span></a>
   <nav class="desktop-nav" aria-label="メインメニュー"><a href="#features">特長</a><a href="#formats">届くムービー</a><a href="#flow">ご利用の流れ</a><a href="#plans">料金</a><a href="#faq">よくある質問</a></nav>
   <a class="button button-primary nav-cta" href="#contact">モニター申込</a>
   <details class="mobile-nav"><summary aria-label="メニューを開く"><span></span><span></span></summary><nav aria-label="モバイルメニュー"><a href="#features">特長</a><a href="#formats">届くムービー</a><a href="#flow">ご利用の流れ</a><a href="#plans">料金</a><a href="#faq">よくある質問</a><a href="#contact">お申し込み・相談</a></nav></details>
  </div>
 </header>
 <main id="main">
  <section class="hero">
   <div class="w hero-grid">
    <div class="hero-copy">
     <p class="hero-kicker"><span class="script">Travel movie for families &amp; couples</span>{c.hero.kicker}</p>
     <h1>{c.hero.lines.map((line,i)=><span class:list={['headline-line',i===1&&'accent-line']}>{line}</span>)}</h1>
     <p class="hero-description">{c.hero.description.map(line=><span class="copy-line">{line}</span>)}</p>
     <ul class="hero-badges">{c.hero.badges.map(b=><li>{b}</li>)}</ul>
     <div class="hero-actions"><a href="#contact" class="button button-primary">{c.cta.primaryLabel}<span aria-hidden="true">→</span></a>{line && <a href={line} class="button button-secondary" {...external(line)}>{c.cta.secondaryLabel}</a>}</div>
     <p class="hero-campaign"><b>{c.campaign.label}</b>{c.campaign.offer}<a href="#campaign">詳しく見る</a></p>
    </div>
    <div class="hero-visual"><HeroReel/></div>
   </div>
   <div class="film-strip" aria-hidden="true"><div class="film-strip-track">{[...Array(2)].map(()=>['OKINAWA','KYOTO','HAKONE','HOKKAIDO','HAWAII','NIKKO','KARUIZAWA','BEPPU'].map(t=><span>{t}</span>))}</div></div>
  </section>

  <section class="section problem-section" id="problem">
   <div class="w">
    <div class="section-heading center"><p class="eyebrow">こんなこと、ありませんか</p><h2>撮るのは、得意。<br/>でも、見返さない。</h2></div>
    <div class="problem-grid">{c.problems.map((p,i)=><article class="problem-card"><span class="problem-no">{String(i+1).padStart(2,'0')}</span><h3>{p.title}</h3><p>{p.text}</p></article>)}</div>
    {proof.length>0 && <div class="proof">{proof.map(p=><figure class="proof-item"><strong>{p.value}</strong><figcaption><span>{p.label}</span><small>{p.note}<a href={p.sourceUrl} target="_blank" rel="noopener">出典 ↗</a></small></figcaption></figure>)}</div>}
    <p class="problem-answer">だから futatabi は、<em>撮る前</em>から、<em>観たあと</em>まで。</p>
   </div>
  </section>

  <section class="section features-section" id="features">
   <div class="w">
    <div class="section-heading"><div><p class="eyebrow">futatabi の特長</p><h2>旅のまえから、<br/>ムービーづくりは始まっている。</h2></div><p>撮り方のコツをお届けするところから、観る人に合わせた仕上げまで。忙しい家族でも、手間なく“ちゃんとした1本”が残るように設計しました。</p></div>
    <div class="feature-grid">{c.features.map((f,i)=><article class="feature-card"><div class="feature-head"><span class="feature-tag">{f.tag}</span><span class="feature-no script">No.{i+1}</span></div><h3>{f.title}</h3><p>{f.text}</p></article>)}</div>
    <div class="cheatsheet" aria-label="撮影カンペのイメージ">
     <div class="cheatsheet-paper">
      <p class="cheatsheet-title"><span class="script">Shot list</span>撮影カンペ（沖縄・子連れ3日間の例）</p>
      <ol>
       <li><b>到着の瞬間</b>空港の自動ドアが開くところを、子どもの背中ごしに</li>
       <li><b>移動中の寝顔</b>3秒でOK。帰り道の車内も</li>
       <li><b>はじめての一歩</b>砂浜や水に足が触れる瞬間を、低い位置から</li>
       <li><b>ごはんの「いただきます」</b>テーブル全体を真上から</li>
       <li><b>撮る人も映る1カット</b>スマホを預けて、家族全員で</li>
      </ol>
      <p class="cheatsheet-more">ほか5カット・質問カード付き</p>
     </div>
     <p class="cheatsheet-caption">行き先と家族構成に合わせて、毎回つくります。</p>
    </div>
   </div>
  </section>

  <section class="section formats-section" id="formats">
   <div class="w">
    <div class="section-heading"><div><p class="eyebrow">届くムービー</p><h2>観る人に合わせて、<br/>3つの形でお届け。</h2></div><p>同じ旅でも、家族で観るとき、SNSに載せるとき、祖父母に送るときで、ちょうどいい長さは違います。</p></div>
    <div class="format-grid">{c.formats.map(f=><article class:list={['format-card',`format-${f.shape}`]}><div class="format-frame"><img src={asset(f.image)} alt="" width="600" height="800" loading="lazy"/><span class="format-play" aria-hidden="true"></span><span class="format-spec">{f.spec}</span></div><h3>{f.name}</h3><p>{f.text}</p></article>)}</div>
   </div>
  </section>

  <section class="letter-section" id="letter">
   <div class="w letter-grid">
    <div><p class="eyebrow light">{c.letter.label}</p><h2>{c.letter.title.map(t=><span class="headline-line">{t}</span>)}</h2><p class="section-copy">{c.letter.text}</p></div>
    <ul class="question-cards">{c.letter.questions.map((q,i)=><li style={`--r:${[-4,3,-2][i]}deg`}><span class="script">Q.{i+1}</span>{q}</li>)}</ul>
   </div>
  </section>

  <section class="section scenes-section" id="scenes">
   <div class="w">
    <div class="section-heading"><div><p class="eyebrow">こんな旅に</p><h2>2度と同じ旅は、<br/>ないから。</h2></div><p>子どもの成長、ふたりの記念日、三世代の旅。残しておきたい理由は、家族の数だけあります。</p></div>
    <ContentCarousel id="scene-track" label="利用シーン">{c.scenes.map(s=><article class="scene-card"><div class="scene-image"><img src={asset(s.image)} alt="" width="600" height="800" loading="lazy"/><span class="scene-category">{s.category}</span></div><div class="scene-body"><h3>{s.title}</h3><p>{s.text}</p></div></article>)}</ContentCarousel>
   </div>
  </section>

  <section class="section flow-section" id="flow">
   <div class="w flow-grid">
    <div class="flow-intro"><p class="eyebrow">ご利用の流れ</p><h2>スマホひとつで、<br/>完結します。</h2><p class="section-copy">専用アプリのインストールも、パソコンも必要ありません。やりとりはLINEとフォームだけ。</p></div>
    <ol class="flow-list">{c.flow.map((s,i)=><li><span class="flow-no script">{String(i+1).padStart(2,'0')}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}</ol>
   </div>
  </section>

  <section class="section plans-section" id="plans">
   <div class="w">
    <div class="section-heading center"><p class="eyebrow">料金プラン</p><h2>旅の大きさに合わせて、<br/>選べる3プラン。</h2><p>表示はすべて税込です。いまならモニター価格（50%OFF）でお申し込みいただけます。</p></div>
    <div class="plan-grid">{c.plans.map(p=><article class:list={['plan-card',p.featured&&'is-featured']}>{p.featured && <span class="plan-ribbon">おすすめ</span>}<p class="plan-label">{p.label}</p><h3 class="plan-name script">{p.name}</h3><p class="plan-price"><s>¥{yen(p.price)}</s><span class="plan-monitor"><small>モニター価格</small>¥<b>{yen(Math.round(p.price/2))}</b></span></p><ul>{p.items.map(t=><li>{t}</li>)}</ul><a href="#contact" class:list={['button',p.featured?'button-primary':'button-secondary']}>このプランで申し込む</a></article>)}</div>
    <div class="options"><h3>オプション</h3><ul>{c.options.map(o=><li><span>{o.name}</span><b>{o.price}</b></li>)}</ul></div>
   </div>
  </section>

  <section class="campaign-band" id="campaign">
   <div class="w campaign-inner">
    <div class="campaign-stamp" aria-hidden="true"><span>先着</span><b>30</b><span>組</span></div>
    <div class="campaign-copy"><p class="eyebrow light">{c.campaign.label}</p><h2>はじめの30組は、<br/>{c.campaign.offer}。</h2><p>{c.campaign.text}</p><small>{c.campaign.note}</small></div>
    <a class="button button-light" href="#contact">{c.cta.primaryLabel}<span aria-hidden="true">→</span></a>
   </div>
  </section>

  <section class="section faq-section" id="faq">
   <div class="w faq-grid">
    <div><p class="eyebrow">よくある質問</p><h2>気になることは、<br/>先にどうぞ。</h2><p class="section-copy">{line ? 'ここにないご質問は、LINEでお気軽に。' : 'ここにないご質問は、申込フォームのご要望欄からどうぞ。'}</p></div>
    <div class="faq-list">{c.faqs.map(f=><details><summary>{f.q}<span aria-hidden="true"></span></summary><p>{f.a}</p></details>)}</div>
   </div>
  </section>

  <section class="contact-section" id="contact">
   <div class="w contact-grid">
    <div><p class="eyebrow">お申し込み・ご相談</p><h2>{c.contact.title.map(t=><span class="headline-line">{t}</span>)}</h2><p class="section-copy">{c.contact.text}</p></div>
    <div class="contact-choice">
     <a class="contact-option is-primary" href={primary} {...external(c.cta.primaryUrl)}><span class="option-symbol" aria-hidden="true">✎</span><div><h3>{c.cta.primaryLabel}</h3><p>フォームで旅行の日程と行き先を送る（約2分）。モニター価格が適用されます。</p></div><span class="option-arrow" aria-hidden="true">→</span></a>
     {line && <a class="contact-option" href={line} {...external(line)}><span class="option-symbol" aria-hidden="true">✉</span><div><h3>{c.cta.secondaryLabel}</h3><p>「こんな動画は作れる？」など、友だち追加して気軽にどうぞ。</p></div><span class="option-arrow" aria-hidden="true">→</span></a>}
     <p class="fine-print">{c.contact.responseNote}</p>
     {!c.cta.primaryUrl && <p class="connection-note" id="connection-note" tabindex="-1">申込フォームは公開準備中です。現在は送信されません。</p>}
     {c.cta.privacyUrl && <a class="text-link" href={c.cta.privacyUrl}>プライバシーポリシー</a>}
    </div>
   </div>
  </section>
 </main>
 <footer class="site-footer">
  <div class="w footer-row">
   <div><p class="footer-brand">{c.companyName}</p><p>旅を、なんどでも。</p></div>
   <nav aria-label="フッターナビゲーション"><a href="#features">特長</a><a href="#plans">料金</a><a href="#faq">よくある質問</a><a href="#contact">お申し込み</a>{c.cta.privacyUrl && <a href={c.cta.privacyUrl}>プライバシーポリシー</a>}</nav>
   <small>© {new Date().getFullYear()} {c.companyName}</small>
  </div>
 </footer>
 <a class="sticky-cta" href="#contact">{c.cta.primaryLabel}<small>{c.campaign.offer}</small></a>
<script>
 const menu=document.querySelector<HTMLDetailsElement>('.mobile-nav');
 menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
 menu?.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus();}});
 const sticky=document.querySelector<HTMLElement>('.sticky-cta');
 const hero=document.querySelector('.hero'), contact=document.querySelector('#contact');
 if(sticky&&hero&&contact&&'IntersectionObserver' in window){
  const seen=new Set<Element>();
  const io=new IntersectionObserver(entries=>{entries.forEach(e=>e.isIntersecting?seen.add(e.target):seen.delete(e.target));sticky.classList.toggle('is-visible',seen.size===0);});
  io.observe(hero);io.observe(contact);
 }
</script>
</body></html>
